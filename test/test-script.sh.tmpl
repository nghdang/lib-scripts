#!/usr/bin/env bash
#
# Source      : <test-source-script.sh>
# Dependencies: <dependency-script-1.sh>
#               <dependency-script-2.sh>
# FUT         : <source-script.sh>
#

# ==================================================================================================
# Initialization
# ==================================================================================================

# ===== Source Guard =====
[[ -n "${G__TEST_SCRIPT_NAME_SH_LOADED:-}" ]] && return 0
declare -rx G__TEST_SCRIPT_NAME_SH_LOADED=1

# ===== Source Dependencies =====
# shellcheck disable=SC1090,SC1091
source "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/lib-testing.sh"

# ==================================================================================================
# Global Constants
# ==================================================================================================

TEST_SCRIPT_PARENT_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
readonly TEST_SCRIPT_PARENT_DIR

FUT_RELATIVE_PATH="../src/<source-script.sh>"
readonly FUT_RELATIVE_PATH

FUT_DEPENDENCY_RELATIVE_PATHS=()
readonly FUT_DEPENDENCY_RELATIVE_PATHS

# ==================================================================================================
# Global Variables
# ==================================================================================================

# ==================================================================================================
# Helper Functions
# ==================================================================================================

#######################################
# Assert the given path is a file or not.
#
# Arguments:
#   file_path [in]: Path of file to assert.
#
# Returns:
#   G__ERR_OK: Path is a file.
#   G__ERR_NOT_FILE: Path is not a file.
#######################################
function _helper__assert_file() {
    # Constants

    # Parameters
    local _file_path

    # Variables

    # Parse and validate arguments
    _file_path="$1"

    # Function body
    if [[ -f "$_file_path" ]]; then
        return "$G__ERR_OK"
    else
        return "$G__ERR_NOT_FILE"
    fi
}

# ==================================================================================================
# Test Cases
# ==================================================================================================

#
# Equivalence class table of `<sut_name>`
# ID    <Param 1>   <Param 2>   ...     Expected    Return Code
# --    ---------   ---------           --------    -----------
# TC1   <value>     <value>             <expected>  <code>
#
function tc__<sut_name>__tc1__<tc_name>() {
    # Constants
    local -r _EXPECTED="expected output"

    # Parameters

    # Variables
    local _file_path="valid_path"
    local _stdout=""
    local _error_code=$G__ERR_OK

    # Function body
    lib_testing__sut_existence "module__<sut_name>"

    _stdout="$(module__<sut_name> "$_file_path")"
    _error_code=$?
    lib_testing__error_code_eq "$G__ERR_OK" "$_error_code"
    lib_testing__eq "$_EXPECTED" "$_stdout" "Output mismatch"
}

# ==================================================================================================
# Entry Point
# ==================================================================================================
function main() {
    set -u

    local _fut_path=""
    local _fut_relative_path=""
    local -a fut_dependency_paths=()

    _fut_path="$(realpath "${TEST_SCRIPT_PARENT_DIR}/${FUT_RELATIVE_PATH}")"

    for _fut_relative_path in "${FUT_DEPENDENCY_RELATIVE_PATHS[@]}"; do
        fut_dependency_paths+=("$(realpath "${TEST_SCRIPT_PARENT_DIR}/${_fut_relative_path}")")
    done

    lib_testing__test_main "$_fut_path" "${fut_dependency_paths[@]}"
}

if [[ "$0" == "${BASH_SOURCE[0]}" ]]; then
    main "$@"
fi
