#
# Arguments:
#   file_path [in]: Path of file to assert.
#
# Returns:
#   G__ERR_OK: Path is a file.
#   G__ERR_NOT_FILE: Path is not a file.
#   G__ERR_MISSING_ARG: No file path was provided.
#######################################
function _module_name__private_function_name() {
    # Constants

    # Parameters
    local _module_name_p01__file_path

    # Variables
    local _module_name_p01__error_code="$G__ERR_OK"

    # Parse and validate arguments
    [[ $# -lt 1 ]] && return "$G__ERR_MISSING_ARG"

    _module_name_p01__file_path="$1"

    # Function body
    if [[ ! -f "$_module_name_p01__file_path" ]]; then
        _module_name_p01__error_code="$G__ERR_NOT_FILE"
    fi

    return "$_module_name_p01__error_code"
}

