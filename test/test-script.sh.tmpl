#!/usr/bin/env bash
#
# Source      : <test-source-script.sh>
# Dependencies: <dependency-script-1.sh>
#               <dependency-script-2.sh>
# FUT         : <source-script.sh>
#

## Explanation
##   Source: Relative path of this test script to the project root dir.
##     - Naming convention: `test-<name of file under test>.sh`.
##
##     - E.g. ./test/test-source-script.sh
##
##   Dependencies: Relative paths of the scripts that this script depends on.
##     - Naming convention: `kebab-case`.
##
##     - E.g. ./test/lib-tests.sh
##
##   FUT: Relative path of the file under test (FUT) to the project root dir.
##

# ----- Source Guard -----
[[ -n "${G__SCRIPT_NAME_SH_LOADED:-}" ]] && return 0
export G__SCRIPT_NAME_SH_LOADED=1

# =============================================================================
# Global Constants
# =============================================================================

## Explanation
##   Constants that shall be used by this script only.
##     - Naming convention: `UPPER_CASE`.
##
##     - These constants shall be declared with `readonly`.
##
##     - E.g. `readonly FILE_SCOPE_CONSTANT="example"`
##

TEST_SCRIPT_PARENT_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
readonly TEST_SCRIPT_PARENT_DIR

LIB_TESTS_PATH="${TEST_SCRIPT_PARENT_DIR}/lib-tests.sh"
readonly LIB_TESTS_PATH

FUT_RELATIVE_PATH="../src/lib-base.sh"
readonly FUT_RELATIVE_PATH

FUT_DEPENDENCY_RELATIVE_PATHS=()
readonly FUT_DEPENDENCY_RELATIVE_PATHS

# =============================================================================
# Global Variables
# =============================================================================

## Explanation
##   Variables that shall be used by this script only.
##     - Naming convention: `snake_case`.
##
##     - E.g. `file_scope_variable="example"`
##

# =============================================================================
# Helper Functions
# =============================================================================

## Explanation
##   Functions that shall be used by test cases in this script only.
##     - Naming convention: `snake_case` with prefix `_helper__`
##
##     - Docstring convention: Custom Google style with Summary, Arguments,
##                             and Returns sections only.
##
##       - Summary: One sentence to describe the function purpose.
##                  `Summary` keyword is omitted for this section.
##
##       - Arguments: List all function parameters with the following format
##                    <param> [in | out | inout]: <description>
##
##       - Returns: List all return codes with the following format
##                  <return code>: <when will this code be returned>
##
##     - E.g.
##       ```
##       #######################################
##       # Assert the given path is a file or not
##       #
##       # Arguments:
##       #   file_path: Path of file to assert
##       #
##       # Returns:
##       #   0: Path is a file
##       #   1: Path is not a file
##       #######################################
##       function _helper__assert_file() {
##           local _file_path="$1"
##
##           if [[ -f "$_file_path" ]]; then
##               return 0
##           else
##               return 1
##           fi
##       }
##       ```
##

# =============================================================================
# Test Cases
# =============================================================================

#
# Equivalence class table of `<sut name>`
# ID    <Param 1>   <Param 2>   ...     Expected    Return Code
# --    ---------   ---------           --------    -----------
# TC1   <value>     <value>             <expected>  <code>
#

## Explanation
##   1. Equivalence class table
##      Describe the input groups, expectation and return code of all test
##      cases of a single software under test (SUT)
##
##   2. Functions that shall be invoked during the test.
##     - Naming convention: `snake_case` with prefix
##                          `tc__<sut name>__<tc id>__<tc name>` where,
##                          `<tc id>` is retrieved from the corresponding
##                           equivalence class table
##
##     - Docstring convention: Test case function does not have docstring.
##
##     - E.g.
##       ```
##       function tc__load_file__tc1__success() {
##           echo "do something"
##       }
##       ```
##

# =============================================================================
# Entry Point
# =============================================================================
function main() {
    # shellcheck disable=SC1090,SC1091
    source "$LIB_TESTS_PATH"

    local _fut_path=""
    local _fut_relative_path=""
    local -a fut_dependency_paths=()

    _fut_path="$(realpath "${TEST_SCRIPT_PARENT_DIR}/${FUT_RELATIVE_PATH}")"

    for _fut_relative_path in "${FUT_DEPENDENCY_RELATIVE_PATHS[@]}"; do
        fut_dependency_paths+=("$(realpath "${TEST_SCRIPT_PARENT_DIR}/${_fut_relative_path}")")
    done

    lib_tests__test_main "$_fut_path" "${fut_dependency_paths[@]}"
}

main
