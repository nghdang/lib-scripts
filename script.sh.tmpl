##   Functions that shall be used by this script only.
##     - Naming convention: `snake_case` with prefix `_<module>__`
##
##     - Docstring convention: Custom Google style with Summary, Arguments,
##                             Outputs, Returns, and Exits sections.
##
##       - Summary: One sentence describing the function's purpose.
##                  The `Summary` keyword is omitted for this section.
##
##       - Arguments: List all function parameters in the following format:
##                    <param> [in | out | inout]: <description>
##
##       - Outputs: List all intended data written to STDOUT. Do not list
##                  diagnostic or informational messages.
##                  Outputs shall be listed in the following format:
##                  <what is written to STDOUT>
##
##       - Returns: List all error codes returned when the function terminates
##                  without exiting the shell.
##                  Error codes shall be listed in the following format:
##                  <error code>: <when this code is returned>
##
##       - Exits: List all exit codes returned when the function terminates
##                and causes the entire shell to terminate.
##                Exit codes shall be listed in the following format:
##                <exit code>: <when this code is returned>
##
##     - Internal structure convention: The function body should be organized
##       into 4 distinct sections:
##         1. `# Constants`: Local constants used within the function.
##         2. `# Variables`: Local variable declarations. Parameter variables
##            shall be at the top and other variables shall be at the bottom,
##            separated by a blank line.
##            - Naming convention: `snake_case` with prefix `_`.
##            - Suffix convention: Same as Global Variables.
##         3. `# Parse and validate arguments`: Argument count and value checks.
##         4. `# Function body`: Main execution logic and return statement.
##
##     - Return code convention:
##       - Standardize on error codes defined in `src/lib-base.sh` (`G__ERR_*`).
##       - Non-mutating functions shall return `$G__ERR_OK` directly without
##         declaring an unused `_error_code` variable.
##       - Mutating functions shall initialize `local _error_code=$G__ERR_OK`,
##         update it as needed, and `return "$_error_code"`.
##

#region _module_name__private_function_name
#######################################
# This is an example of a private function.
#
# Arguments:
#   file_path [in]: Path of file to assert.
#
# Returns:
#   G__ERR_OK: Path is a file.
#   G__ERR_NOT_FILE: Path is not a file.
#   G__ERR_MISSING_ARG: No file path was provided.
#######################################
#endregion _module_name__private_function_name
function _module_name__private_function_name() {
    # Constants

    # Variables
    local _file_path

    local _error_code="$G__ERR_OK"

    # Parse and validate arguments
    [[ $# -lt 1 ]] && return "$G__ERR_MISSING_ARG"

    _file_path="$1"

    # Function body
    if [[ ! -f "$_file_path" ]]; then
        _error_code="$G__ERR_NOT_FILE"
    fi

    return "$_error_code"
}

